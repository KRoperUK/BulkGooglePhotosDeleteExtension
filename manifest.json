{
  "manifest_version": 3,
  "name": "Bulk Delete Google Photos",
  "version": "1.0.0",
  "description": "Select and delete your own Google Photos in batches. Dry run, stop control, no limits, no network requests.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
