{
  "manifest_version": 3,
  "name": "Bulk Delete Google Photos",
  "version": "1.3.0",
  "description": "Select and delete your own Google Photos in batches. Dry run, stop control, no limits, no network requests.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bulk Delete Google Photos",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ]
}
